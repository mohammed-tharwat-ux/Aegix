
{
  "name": "aegix",
  "module": "Aegix-API.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"bun run --watch Aegix-API.ts\" \"vite --host 0.0.0.0\"",
    "dev:api": "bun run --watch Aegix-API.ts",
    "dev:web": "vite --host 0.0.0.0",

    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",

    "build:extension": "vite build --config extension/vite.config.ts && bun extension/copy-static.ts",
    "dev:extension": "vite build --watch --config extension/vite.config.ts",

    "start": "bun run Aegix-API.ts",

    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@google/genai": "^2.6.0",
    "concurrently": "^10.0.0",
    "elysia": "^1.4.28",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.1.8"
  }
}

